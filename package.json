{
  "name": "knowledge-graph-of-industrial-music",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive knowledge graph of industrial music.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/publish-graph-data.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "node scripts/validate-graph.mjs",
    "enrich:musicbrainz": "node scripts/enrich-musicbrainz.mjs",
    "enrich:musicbrainz:people": "node scripts/enrich-musicbrainz.mjs --phase=people",
    "enrich:musicbrainz:projects": "node scripts/enrich-musicbrainz.mjs --phase=projects",
    "enrich:musicbrainz:releases": "node scripts/enrich-musicbrainz.mjs --phase=releases",
    "enrich:musicbrainz:aliases": "node scripts/enrich-artist-aliases.mjs",
    "import:musicbrainz:members": "node scripts/import-project-members.mjs",
    "import:musicbrainz:releases": "node scripts/import-release-credits.mjs",
    "discover:musicbrainz:industrial": "node scripts/discover-industrial-projects.mjs",
    "enrich:wikidata": "node scripts/enrich-wikidata.mjs",
    "enrich:wikidata:next": "node scripts/enrich-wikidata.mjs --offset=0 --limit=20",
    "enrich:wikidata:missing": "node scripts/enrich-wikidata.mjs --missing-only --offset=0 --limit=20"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "three": "^0.186.0"
  }
}
